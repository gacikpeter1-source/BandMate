rules_version = '2';

// Pictures are public to read (fans must see them). Only the band's own approved members, or the
// BandMate operator, can upload or remove them, and only inside their band's folder:
//   bands/{bandId}/qr|logo|photos/*
// Role is read from Firestore bands/{bandId}/members/{uid}.role and must have a verified email.
service firebase.storage {
  match /b/{bucket}/o {
    function verified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function isPlatform() {
      return verified() && firestore.exists(/databases/(default)/documents/platformAdmins/$(request.auth.uid));
    }
    function isStaffOf(bandId) {
      return verified() && (
        isPlatform() || (
          firestore.exists(/databases/(default)/documents/bands/$(bandId)/members/$(request.auth.uid))
          && firestore.get(/databases/(default)/documents/bands/$(bandId)/members/$(request.auth.uid)).data.role in ['bandmate', 'admin']
          && firestore.get(/databases/(default)/documents/bands/$(bandId)).data.status == 'active'
        )
      );
    }

    // ---- PLAN LIMITS (keep in step with src/lib/plans.ts and firestore.rules) ---------------------
    // Picture space = 50 MB (free) or 150 MB (paid), plus 150 MB per add-on pack on the band record.
    // The total used so far is bands/{bandId}/settings/usage.bytes, kept up to date by the app.
    function maxBytes(bandId) {
      let band = firestore.get(/databases/(default)/documents/bands/$(bandId)).data;
      return ((band.get('plan', 'free') == 'paid' ? 150 : 50) + band.get('extraPacks', 0) * 150) * 1024 * 1024;
    }
    function usedBytes(bandId) {
      let u = /databases/(default)/documents/bands/$(bandId)/settings/usage;
      return firestore.exists(u) ? firestore.get(u).data.get('bytes', 0) : 0;
    }

    // Listing a band's folders (to delete a whole band) is for the BandMate operator only.
    match /bands/{bandId}/{allPaths=**} {
      allow list: if isPlatform();
    }

    match /bands/{bandId}/{folder}/{file} {
      allow read: if true;
      allow create, update: if isStaffOf(bandId)
        && folder in ['qr', 'logo', 'photos']
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*')
        && usedBytes(bandId) + request.resource.size <= maxBytes(bandId);
      allow delete: if isStaffOf(bandId);
    }

    // LEGACY single-band folder (old root layout). REMOVE after the migration is confirmed.
    match /public/{folder}/{file} {
      function legacyStaff() {
        return verified()
          && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
          && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['bandmate', 'admin'];
      }
      allow read: if true;
      allow create, update: if legacyStaff()
        && folder in ['qr', 'logo', 'photos']
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if legacyStaff();
    }
  }
}
